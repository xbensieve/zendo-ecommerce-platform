# -------------------------------------------------------------
# Zendo Production Environment Variables - EXAMPLE
# -------------------------------------------------------------
# WARNING: Do NOT commit your actual .env file to version control.
# Copy this file to .env and replace PLACEHOLDER values before deploying.
# -------------------------------------------------------------

# Active Spring Profile (must be 'prod' in production)
SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_HOST=PLACEHOLDER_DB_HOST
DB_PORT=5432
DB_NAME=zendo_prod
DB_USER=PLACEHOLDER_DB_USER
DB_PASSWORD=PLACEHOLDER_DB_PASSWORD

# --- Redis ---
REDIS_HOST=PLACEHOLDER_REDIS_HOST
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=PLACEHOLDER_RABBITMQ_HOST
RABBITMQ_PORT=5672
RABBITMQ_USER=PLACEHOLDER_RABBITMQ_USER
RABBITMQ_PASSWORD=PLACEHOLDER_RABBITMQ_PASSWORD

# --- Security ---
# Must be a secure, random string (at least 256-bit / 32 characters)
JWT_SECRET=PLACEHOLDER_JWT_SECRET
JWT_ISSUER=zendo-production
JWT_EXPIRATION_MS=3600000
# Internal RabbitMQ HMAC event-signing secret (at least 256-bit / 32 characters)
EVENT_SIGNING_SECRET=PLACEHOLDER_EVENT_SIGNING_SECRET
