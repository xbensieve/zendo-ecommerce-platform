<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console appender — human-readable for local development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Structured JSON console appender for production -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Includes MDC fields like traceId, spanId automatically -->
            <timeZone>UTC</timeZone>
        </encoder>
    </appender>

    <!-- Default: use human-readable console in dev/test, but in prod we could switch to JSON_CONSOLE. 
         We'll just leave CONSOLE by default, and springProfile for prod to use JSON. -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Reduce noise from infrastructure libraries -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="org.testcontainers" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

</configuration>
